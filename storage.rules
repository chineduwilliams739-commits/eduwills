rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function imageFile() { return request.resource != null && request.resource.contentType.matches('image/.*'); }
    function smallEnough() { return request.resource != null && request.resource.size < 8 * 1024 * 1024; }

    match /users/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && imageFile() && smallEnough();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && imageFile() && smallEnough();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Group images uploaded by DeviceImageUpload use community/{uid}/{fileName}.
    match /community/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && imageFile() && smallEnough();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Keep compatibility with any older group-image paths that include groupId.
    match /community/{groupId}/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && imageFile() && smallEnough();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /chatImages/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && imageFile() && smallEnough();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
