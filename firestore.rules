rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.phone == resource.data.phone);
      allow delete: if isAdmin();
    }

    match /williTokens/{tokenId} {
      allow create: if isAdmin()
        && request.resource.data.token == tokenId
        && request.resource.data.used == false;
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.used == false
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.token == resource.data.token
        && request.resource.data.used == true
      );
      allow delete: if isAdmin();
    }

    match /quizHistory/{historyId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /books/{bookId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bookSlots/{slotId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /supportMessages/{messageId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
