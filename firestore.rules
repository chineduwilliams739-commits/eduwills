rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function currentUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /phoneIndex/{phone} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && (request.auth.uid == request.resource.data.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /williTokens/{tokenId} {
      allow create: if isAdmin() && request.resource.data.token == tokenId && request.resource.data.used == false;
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.username == currentUsername());
      // A user can redeem an unused token assigned to their EDUWILLS username.
      // This deliberately supports older tokens whose stored userId may be a
      // legacy Firestore document ID. The redeemed token is migrated to auth.uid.
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.used == false &&
        resource.data.username == currentUsername() &&
        request.resource.data.token == resource.data.token &&
        request.resource.data.used == true &&
        request.resource.data.username == currentUsername() &&
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /quizHistory/{historyId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /books/{bookId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bookSlots/{slotId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /supportMessages/{messageId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
